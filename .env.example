# Required for intent parsing + summaries (free key: https://console.groq.com/keys)
GROQ_API_KEY=
# Optional overrides
INTENT_MODEL=openai/gpt-oss-20b
SUMMARY_MODEL=openai/gpt-oss-120b
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
MAX_PAGES_CAP=20
MAX_DEPTH_CAP=2
CRAWL_TIMEOUT_S=45
RATE_LIMIT_PER_MIN=8
